# ---- mplan API ----
# MySQL 地址：docker-compose.yml 映射到本机 3308
DATABASE_URL=mysql://root:mplan@127.0.0.1:3308/mplan

# API 端口
PORT=8787

# 允许发起写请求的前端 Origin（逗号分隔；开发环境可只写 localhost:5173）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 登录会话有效期（天）
SESSION_DAYS=7

# 走 HTTPS 时设为 1，会话 Cookie 会带上 Secure
COOKIE_SECURE=0

# 首次 db:seed 时的默认管理员（users 表为空才会创建）
# MPLAN_SEED_USER=admin
# MPLAN_SEED_PASSWORD=mplan123
# MPLAN_SEED_NAME=管理员
