# 部署配置：复制为 .deploy.env 后填写，.deploy.env 已加入 .gitignore
SERVER_HOST="1.2.3.4"
SERVER_PORT="22"
SERVER_USER="root"
SERVER_PASS="ssh-password"

REMOTE_DIR="/opt/mplan"
PUBLIC_HOST="1.2.3.4"
PUBLIC_PORT="8102"
PUBLIC_ORIGIN="http://1.2.3.4:8102"

NODE_VERSION="22.14.0"
PNPM_VERSION="11.22.0"

MYSQL_CONTAINER="mysql-latest"
MYSQL_ROOT_PASS="mysql-root-password"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DB="mplan"
MYSQL_USER="root"
MYSQL_PASS="mysql-root-password"

# 初始管理员（仅首次部署创建；已存在不会重置密码）
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="管理员"
